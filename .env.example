# Copy to .env and fill in. The server refuses to start on an incomplete config.

DATABASE_URL=postgresql://scholia:scholia@localhost:54330/scholia

# Auth: "bearer" (one shared token, e.g. for Claude Code) or "github"
# (OAuth, required by claude.ai connectors).
AUTH_MODE=bearer
BEARER_TOKEN=change-me-to-a-long-random-string

# AUTH_MODE=github: create a GitHub OAuth App whose callback URL is
# <BASE_URL>/auth/callback. Only the listed accounts get in: logins or, safer
# (logins can be renamed and re-registered), numeric IDs from
# `gh api users/<login> --jq .id`. Comma-separated.
ALLOWED_GITHUB_USERS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=

# Embeddings: "voyage" or "openai". EMBEDDING_MODEL defaults to the provider's
# (voyage-3.5-lite / text-embedding-3-small). Changing provider, model or
# FTS_LANGUAGE later requires `scholia-mcp reindex`.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Postgres text search configuration, e.g. english, portuguese.
FTS_LANGUAGE=english

# Cosine similarity (0-1) a note needs to show up without a keyword match.
# 0 = off. Calibrate against your embedder's real scores before raising it.
MIN_SIMILARITY=0

HOST=0.0.0.0
PORT=8000
